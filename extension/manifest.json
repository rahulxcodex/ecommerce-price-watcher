{
  "manifest_version": 3,
  "name": "PriceWatcher Companion",
  "version": "1.2.0",
  "description": "One-click product price tracker for Amazon, Flipkart, Myntra, Ajio, Meesho & Westside.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track this item on PriceWatcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "https://*.meesho.com/*",
    "https://*.myntra.com/*",
    "https://*.ajio.com/*",
    "https://*.westside.com/*",
    "http://localhost:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
