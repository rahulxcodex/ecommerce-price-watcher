# Supabase Configuration
# Required for both web application and scraping runner
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY: KEEP STRICTLY SECRET! Used only by GitHub Actions scraper & secure API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication Session Secret (HMAC-SHA256 signature for stateless auth cookies, min 32 chars)
AUTH_SECRET=generate-a-strong-random-secret-at-least-32-chars-long

# Telegram Bot Alerts (Free, unlimited)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=generate-a-strong-random-secret-here

# App URL (e.g., https://your-app.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
